{
	"name": "chatify",
	"version": "0.2.0",
	"description": "Angular-based chatting application. Provides capabilities like authorization and encrypted chats between users with real-time features",
	"author": "Vladyslav Supruniuk",
	"private": false,
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/vsupruniuk/chatify"
	},
	"scripts": {
		"start:dev": "ng serve --configuration dev",
		"start:prod": "ng serve --configuration prod",
		"build:dev": "ng build --configuration dev",
		"build:prod": "ng build --configuration prod",
		"test:cov": "jest --coverage --runInBand",
		"test:unit": "jest --runInBand --coverage=false",
		"lint": "ng lint && npx stylelint \"src/**/*.scss\" --fix",
		"lint:ci": "ng lint && npx stylelint \"src/**/*.scss\"",
		"format": "prettier --write \"src/**/*.ts\"",
		"type-check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
		"prepare": "husky",
		"convert-coverage": "ts-node scripts/convertHtmlCoverageToSonar.ts"
	},
	"dependencies": {
		"@angular/common": "22.1.3",
		"@angular/compiler": "22.1.3",
		"@angular/core": "22.1.3",
		"@angular/forms": "22.1.3",
		"@angular/platform-browser": "22.1.3",
		"@angular/router": "22.1.3",
		"@ngrx/store": "22.0.0",
		"@ngrx/store-devtools": "22.0.0",
		"@ngxpert/hot-toast": "6.4.1",
		"rxjs": "7.8.2",
		"tslib": "2.8.1"
	},
	"devDependencies": {
		"@angular/build": "22.1.5",
		"@angular/cli": "22.1.5",
		"@angular/compiler-cli": "22.1.3",
		"@eslint/js": "10.0.1",
		"@stylistic/stylelint-plugin": "5.3.0",
		"@types/jest": "30.0.0",
		"angular-eslint": "22.1.0",
		"eslint": "10.8.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.6",
		"eslint-plugin-unicorn": "73.0.0",
		"husky": "9.1.7",
		"jest": "30.4.2",
		"jest-environment-jsdom": "30.4.1",
		"jest-preset-angular": "17.0.0",
		"jiti": "2.7.0",
		"ng-mocks": "14.17.2",
		"prettier": "3.9.6",
		"stylelint": "17.14.1",
		"stylelint-config-clean-order": "10.0.0",
		"stylelint-config-standard-scss": "17.0.0",
		"stylelint-order": "8.1.1",
		"ts-jest": "29.4.12",
		"ts-node": "10.9.2",
		"typescript": "6.0.3",
		"typescript-eslint": "8.67.0"
	},
	"overrides": {
		"glob": "13.0.6",
		"jsdom": "30.0.1"
	}
}
